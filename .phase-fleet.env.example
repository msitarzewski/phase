# Private local fleet configuration template.
#
# Copy this file to `.phase-fleet.local.env` (which is gitignored) and fill in
# your real SSH aliases/hosts, static relay IP, and local model paths. Never
# commit real hostnames, usernames, IP addresses, or credentials.

# GitHub repository and release tag used by `scripts/install-lucid.sh` /
# `scripts/fleet-install.sh`. Use a prerelease tag (e.g. v0.2.0-rc1) when
# testing release candidates across machines.
PHASE_RELEASE_REPO="msitarzewski/phase"
PHASE_RELEASE_TAG="latest"

# Cloud Relay (sole host with direct static external IPv4).
# Example uses RFC 5737 documentation IP 203.0.113.10 — replace locally.
PHASE_CLOUD_RELAY_SSH="user@cloud-relay-alias"
PHASE_CLOUD_RELAY_PUBLIC_IP="203.0.113.10"
PHASE_CLOUD_RELAY_PORT="4001"

# Behind-NAT Linux & macOS test hosts (SSH aliases from your local ~/.ssh/config).
PHASE_UBUNTU_DESKTOP_SSH="user@ubuntu-desktop-alias"
PHASE_UBUNTU_LAPTOP_SSH="user@ubuntu-laptop-alias"
PHASE_MAC_M1_MAX_SSH="user@mac-m1-max-alias"

# Optional contributor paths on behind-NAT hosts.
PHASE_UBUNTU_DESKTOP_MODEL_DIR="/path/to/gguf-models"
PHASE_UBUNTU_DESKTOP_LLAMA_SERVER="/usr/local/bin/llama-server"
PHASE_MAC_M1_MAX_MLX_SERVER="/path/to/venv/bin/mlx_lm.server"
PHASE_MAC_M1_MAX_MLX_BUNDLE="/path/to/readonly-mlx-bundle"
PHASE_MAC_M1_MAX_MLX_ALIAS="mlx-test-model"
