# Rust workspace
/target/
/target-linux-amd64/
/target-linux-arm64/
/target-linux-x86_64/
**/target/

# Per-crate locks (workspace Cargo.lock IS committed; only per-example locks ignored)
/wasm-examples/*/Cargo.lock

# PHP
/php-sdk/vendor/
composer.lock

# Build artifacts
/build/
/_site/

# Binaries
*.wasm
dist/lucidd-*/lucidd

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local AI tool configs
.cascade_todo.json
.claude/

# Private key material. The Phase substrate uses Ed25519 keypairs via
# phase-identity. Public keys (peer-ids) are safe to publish; private
# keys are not. These patterns prevent accidental commits if someone
# ever runs lucidd from inside the repo dir or scp's an identity.key
# in for setup work. The legitimate location is always
# ~/.config/phase/identity.key (Linux) or the platform equivalent.
identity.key
*.identity.key
**/identity.key
*.key
!keys/*.pub.placeholder

# Code signing certificates, Apple API keys, provisioning profiles, and temp signing metadata.
*.p12
*.pfx
*.p8
*.cer
*.mobileprovision
*.provisionprofile
artifact-signing.json

# Local daemon control credentials and one-use enrollment invitations.
*.control-token
control-*.token
*.lucidinvite

# Private local fleet topology / SSH / relay configuration (never commit hostnames or IPs).
.phase-fleet.local.env
*.local.env

# Tauri v2 desktop app build artifacts & staged sidecar binaries
apps/lucid-desktop/node_modules/
apps/lucid-desktop/dist/
apps/lucid-desktop/src-tauri/target/
apps/lucid-desktop/src-tauri/gen/
apps/lucid-desktop/src-tauri/binaries/lucidd*
